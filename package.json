{
  "name": "dsh-bankrec",
  "version": "0.1.1",
  "description": "Bank statement ingest, CAMT.053/MT940 reconciliation and 3-sheet workpaper.",
  "type": "module",
  "main": "./lib/plugin/index.js",
  "types": "./lib/plugin/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/plugin/index.d.ts",
      "default": "./lib/plugin/index.js"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "NOTICE",
    "THIRD-PARTY-NOTICES",
    "README-zh.md",
    "README-es.md",
    "README-pt.md",
    "README-hi.md",
    "docs/assets",
    "samples",
    "SECURITY.md",
    "PRIVACY.md",
    "CODE_OF_CONDUCT.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "TROUBLESHOOTING.md",
    "screenshots.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "demo": {
      "sample": "samples/quickstart/input",
      "prompt": "帮我用自带样例跑一次银行流水对账，告诉我匹配了几笔、还有哪几笔没对上，并导出三张表的底稿。",
      "expect": "samples/quickstart/expected/result.json",
      "screenshot": "docs/assets/quickstart.png",
      "reads": [
        "用户指定的银行流水/总账 CSV、CAMT.053/054/056 XML、MT940 文本"
      ],
      "writes": [
        "$DSH_HOME/storages/dsh-bankrec"
      ],
      "network": false,
      "external": []
    },
    "capabilities": [
      "tools:register"
    ],
    "labels": []
  },
  "engines": {
    "dsh": ">=0.2.1-rc.3 <0.4.0",
    "node": ">=24.9.0 <25"
  },
  "packageManager": "pnpm@11.28.5",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "node scripts/lint.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --test test/*.test.mjs",
    "prepublishOnly": "node scripts/check-npm-name.mjs",
    "pack:check": "npm pack --dry-run --json > pack.json && node scripts/check-pack.mjs",
    "gate:sku06": "node scripts/gate-sku06.mjs"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "bank-rec",
    "reconciliation",
    "finance",
    "perrylink",
    "camt",
    "mt940"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PerryLink/dsh-bankrec.git"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.5 <5.0.0",
    "@deepseek-ai/dsh-storage-domain": ">=0.2.1-rc.3 <0.4.0",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.3 <0.4.0"
  },
  "dependencies": {
    "fast-xml-parser": "5.11.2",
    "fflate": "0.8.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.3",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.3",
    "@deepseek-ai/dsh-scope": "0.2.1-rc.3",
    "@deepseek-ai/dsh-session": "0.2.1-rc.3",
    "@deepseek-ai/dsh-storage": "0.2.1-rc.3",
    "@deepseek-ai/dsh-storage-domain": "0.2.1-rc.3",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.3",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.3",
    "@deepseek-ai/dsh-user-approval": "0.2.1-rc.3",
    "@deepseek-ai/dsh-util-values": "0.2.1-rc.3",
    "@deepseek-ai/schemastery": "3.18.5",
    "@types/node": "^24.0.0",
    "typescript": "7.0.2"
  },
  "homepage": "https://perrylink.github.io/dsh-plugins/packages/dsh-bankrec.html",
  "bugs": {
    "url": "https://github.com/PerryLink/dsh-bankrec/issues"
  },
  "icon": "icon.svg",
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-storage-domain": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  }
}
